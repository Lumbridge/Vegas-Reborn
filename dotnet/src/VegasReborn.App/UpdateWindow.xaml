<Window x:Class="VegasReborn.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updating Vegas Reborn" Icon="Assets/vegas-reborn.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource BodyFont}" FontSize="14"
        UseLayoutRounding="True">
    <StackPanel Margin="28,24">
        <TextBlock Text="Updating Vegas Reborn" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="20" />
        <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="0,8,0,16" TextWrapping="Wrap" Text="Preparing the update..." />
        <ProgressBar x:Name="Bar" Height="6" IsIndeterminate="True" Foreground="{StaticResource Accent}" Background="{StaticResource Panel}" BorderThickness="0" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,16,0,0" FontSize="12" TextWrapping="Wrap"
                   Text="Keep this window open. Your games, account and characters are not changed." />
    </StackPanel>
</Window>
