<Window x:Class="VegasReborn.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VegasReborn.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Vegas Reborn" Icon="Assets/vegas-reborn.ico"
        Width="1180" Height="800" MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource BodyFont}" FontSize="14">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <DataTemplate x:Key="FixRow" DataType="{x:Type vm:FixViewModel}">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Expander Style="{StaticResource FixExpander}">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" LineHeight="20" FontSize="13" />
                    </Expander>
                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="24,2,0,0"
                              IsChecked="{Binding IsEnabled}" AutomationProperties.Name="{Binding Title}"
                              Visibility="{Binding IsToggle, Converter={StaticResource Visible}}" />
                    <TextBlock Grid.Column="1" Text="Always on" Style="{StaticResource MutedText}" VerticalAlignment="Top" Margin="24,4,0,0">
                        <TextBlock.Visibility>
                            <Binding Path="IsToggle">
                                <Binding.Converter>
                                    <vm:InverseVisibilityConverter />
                                </Binding.Converter>
                            </Binding>
                        </TextBlock.Visibility>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Brand and top navigation -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,36,0">
                    <Image Source="{StaticResource LogoImage}" Width="30" Height="30" Margin="0,0,10,0" />
                    <TextBlock Text="Vegas Reborn" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Bottom" Margin="8,0,0,3" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource NavTab}" Content="Games" GroupName="Nav" IsChecked="{Binding IsGames}" />
                    <RadioButton Style="{StaticResource NavTab}" Content="Account" GroupName="Nav" IsChecked="{Binding IsAccount}" />
                    <RadioButton Style="{StaticResource NavTab}" Content="Settings" GroupName="Nav" IsChecked="{Binding IsSettings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Games page -->
        <Grid Grid.Row="1" Visibility="{Binding IsGames, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="12,16">
                <ListBox Style="{StaticResource GameList}" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                         AutomationProperties.Name="Games">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GameViewModel}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Accent}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExperimental}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Warn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="13" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          DataContext="{Binding SelectedGame}">
                <StackPanel>
                    <!-- Game banner -->
                    <Grid Height="230">
                        <Image Source="Assets/vegas-night.png" Stretch="UniformToFill" VerticalAlignment="Center" />
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#33111513" Offset="0" />
                                    <GradientStop Color="#F2111513" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <DockPanel VerticalAlignment="Bottom" Margin="40,0,40,24">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Launch game" VerticalAlignment="Bottom" Command="{Binding LaunchCommand}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="38" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Visibility="{Binding IsExperimental, Converter={StaticResource Visible}}"
                                           Text="Online support is being tested. Sign-in may not work yet." Foreground="{StaticResource Warn}" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>

                    <StackPanel Margin="40,8,40,40" MaxWidth="980" HorizontalAlignment="Stretch">
                        <!-- Launch and sign-in status -->
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4"
                                Padding="14,10" Margin="0,8,0,8"
                                Visibility="{Binding DataContext.HasMessage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.Message, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                                <ProgressBar Margin="0,8,0,2" Maximum="100" Background="{StaticResource Line}" AutomationProperties.Name="Game copy progress"
                                             Value="{Binding DataContext.CopyPercent, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, TargetNullValue=0}"
                                             Visibility="{Binding DataContext.HasCopyProgress, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </Border>

                        <!-- Game folder -->
                        <DockPanel Margin="0,8,0,24">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Browse" Margin="12,0,0,0" Command="{Binding BrowseCommand}" />
                            <StackPanel>
                                <TextBlock Text="Game folder" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding GameFolder}" Style="{StaticResource MutedText}" FontSize="13" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Extra Maps (Vegas 1 only) -->
                        <ContentControl Content="{Binding MapsPack}" Focusable="False" IsTabStop="False">
                            <ContentControl.ContentTemplate>
                                <DataTemplate DataType="{x:Type vm:MapsPackViewModel}">
                                    <StackPanel Margin="0,16,0,8">
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Extra Maps" Style="{StaticResource SectionHeading}" />
                                                <TextBlock Style="{StaticResource SectionLead}"
                                                           Text="Kitchen, Roof, Ruined, Trains, Neon, Presidio, Mexico, Streets, Killhouse Double, Tower. Adds Terrorist Hunt, Deathmatch, Team Deathmatch and Attack &amp; Defend to story missions. The added modes have not been tested in a full online match yet." />
                                                <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"
                                                           Text="Players need Extra Maps to join matches that use these maps." />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel>
                                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="{Binding DownloadText}" Command="{Binding DownloadCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding DisabledReason}"
                                                    Visibility="{Binding ShowDownload, Converter={StaticResource Visible}}" />
                                            <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource Visible}}">
                                                <ProgressBar Maximum="100" Height="8" Margin="0,0,0,8" Background="{StaticResource Line}" Value="{Binding Percent, Mode=OneWay}"
                                                             AutomationProperties.Name="Extra Maps download progress" />
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="12,0,0,0" Command="{Binding CancelCommand}" />
                                                    <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                                </DockPanel>
                                            </StackPanel>
                                            <DockPanel Visibility="{Binding ShowInstalled, Converter={StaticResource Visible}}">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Remove" Margin="12,0,0,0" Command="{Binding RemoveCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding DisabledReason}" />
                                                <TextBlock Text="Installed" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Visibility="{Binding ShowUpdate, Converter={StaticResource Visible}}">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                                    <Button Style="{StaticResource SecondaryButton}" Content="Update" Command="{Binding UpdateCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding DisabledReason}" />
                                                    <Button Style="{StaticResource SecondaryButton}" Content="Remove" Margin="8,0,0,0" Command="{Binding RemoveCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding DisabledReason}" />
                                                </StackPanel>
                                                <TextBlock Text="A newer version of Extra Maps is available" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <DockPanel Visibility="{Binding ShowDamaged, Converter={StaticResource Visible}}">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                                    <Button Style="{StaticResource SecondaryButton}" Content="Download again" Command="{Binding DownloadCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding DisabledReason}" />
                                                    <Button Style="{StaticResource SecondaryButton}" Content="Remove" Margin="8,0,0,0" Command="{Binding RemoveCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding DisabledReason}" />
                                                </StackPanel>
                                                <TextBlock Text="Extra Maps is damaged. Download it again or remove it." VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </StackPanel>
                                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"
                                                   Visibility="{Binding HasStatus, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- Fix sections -->
                        <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FixSectionViewModel}">
                                    <StackPanel Margin="0,16,0,8">
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionHeading}" />
                                                <TextBlock Text="{Binding Lead}" Style="{StaticResource SectionLead}" />
                                            </StackPanel>
                                        </Border>
                                        <!-- Display mode and monitor lead the game fixes -->
                                        <StackPanel Visibility="{Binding ShowsDisplay, Converter={StaticResource Visible}}">
                                        <StackPanel DataContext="{Binding Display}">
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,14">
                                            <DockPanel>
                                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding DisplayModeNames}" SelectedItem="{Binding SelectedDisplayMode}" Width="240"
                                                          AutomationProperties.Name="Display mode" />
                                                <StackPanel>
                                                    <TextBlock Text="Display mode" FontWeight="SemiBold" FontSize="15" />
                                                    <TextBlock Text="Borderless fills your selected monitor without staying on top." Style="{StaticResource MutedText}" FontSize="13" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,14"
                                                Visibility="{Binding ShowsMonitor, Converter={StaticResource Visible}}">
                                            <DockPanel>
                                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}"
                                                          AutomationProperties.Name="Monitor" Width="240" />
                                                <StackPanel>
                                                    <TextBlock Text="Monitor" FontWeight="SemiBold" FontSize="15" />
                                                    <TextBlock Text="Where the game window opens." Style="{StaticResource MutedText}" FontSize="13" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        </StackPanel>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Fixes}" ItemTemplate="{StaticResource FixRow}" Focusable="False" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Account page -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      Visibility="{Binding DataContext.IsAccount, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" DataContext="{Binding Account}">
            <StackPanel Margin="48,36,48,48" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Account" Style="{StaticResource SectionHeading}" FontSize="26" />
                <TextBlock Text="Sign in with Discord to play online and keep your character between PCs." Style="{StaticResource SectionLead}" />

                <!-- Signed out -->
                <StackPanel Margin="0,24,0,0">
                    <StackPanel.Visibility>
                        <Binding Path="IsSignedIn">
                            <Binding.Converter>
                                <vm:InverseVisibilityConverter />
                            </Binding.Converter>
                        </Binding>
                    </StackPanel.Visibility>
                    <TextBlock Text="Your browser opens Discord. Approve the sign-in there, then return here." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Sign in with Discord" Command="{Binding SignInCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="12,0,0,0" Command="{Binding CancelSignInCommand}"
                                Visibility="{Binding IsSigningIn, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </StackPanel>

                <!-- Signed in -->
                <StackPanel Margin="0,24,0,0" Visibility="{Binding IsSignedIn, Converter={StaticResource Visible}}">
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,18">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Sign out" VerticalAlignment="Center" Command="{Binding SignOutCommand}" />
                            <StackPanel>
                                <TextBlock Text="{Binding PlayerName}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="22" />
                                <TextBlock Text="{Binding DiscordName}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Player name -->
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,18" Visibility="{Binding ShowNameSection, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="Player name" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{Binding NameHelp}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <DockPanel Margin="0,10,0,0" Visibility="{Binding CanClaimName, Converter={StaticResource Visible}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Save name" Margin="12,0,0,0" Command="{Binding ClaimNameCommand}" />
                                <TextBox Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" AutomationProperties.Name="Player name" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Character sync -->
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,18">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Sync now" VerticalAlignment="Top" Margin="24,0,0,0"
                                    Command="{Binding SyncCommand}" Visibility="{Binding SyncAvailable, Converter={StaticResource Visible}}" />
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" FontSize="15">
                                    <Run Text="Character, " /><Run Text="{Binding SyncTitle, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding SyncHelp}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Conflict choice -->
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="4" Padding="18,16" Margin="0,18,0,0"
                            Visibility="{Binding HasConflict, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="Choose a character" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Warn}" />
                            <TextBlock Text="{Binding ConflictText}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,14" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Content="Keep this PC's character" Command="{Binding KeepLocalCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Keep the account's character" Margin="12,0,0,0" Command="{Binding KeepCloudCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="0,18,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>

        <!-- Settings page -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      Visibility="{Binding DataContext.IsSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" DataContext="{Binding Settings}">
            <StackPanel Margin="48,36,48,48" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Settings" Style="{StaticResource SectionHeading}" FontSize="26" />
                <TextBlock Text="Launcher behaviour and updates. Display options are on each game's page." Style="{StaticResource SectionLead}" />

                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,14" Margin="0,16,0,0">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding MinimizeOnPlay}" AutomationProperties.Name="Minimise while playing" />
                        <StackPanel>
                            <TextBlock Text="Minimise while playing" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="The launcher comes back when the game closes." Style="{StaticResource MutedText}" FontSize="13" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,14">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding DiscordPresence}" AutomationProperties.Name="Discord activity" />
                        <StackPanel>
                            <TextBlock Text="Discord activity" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Show the game you are playing on your Discord profile." Style="{StaticResource MutedText}" FontSize="13" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,14">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding CheckUpdates}" AutomationProperties.Name="Check for updates at startup" />
                        <StackPanel>
                            <TextBlock Text="Check for updates at startup" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Updates are only installed when you choose to." Style="{StaticResource MutedText}" FontSize="13" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="Updates" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource SectionLead}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar Margin="0,12,0,0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                                     Visibility="{Binding HasProgress, Converter={StaticResource Visible}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="Check for updates" Command="{Binding CheckCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Update and restart" Margin="12,0,0,0" Command="{Binding InstallCommand}"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource Visible}}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Force-close games and update" Margin="12,0,0,0" Command="{Binding ForceCommand}"
                                    Visibility="{Binding UpdateBlocked, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
